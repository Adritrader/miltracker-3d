# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3001

# ─── ADS-B data (NO registration needed for any of these)
# Primary:  https://api.adsb.lol/v2/mil
# Fallback: https://opendata.adsb.fi/api/v2/mil
# Fallback: https://api.airplanes.live/v2/mil
# All three are free, public, no API key required.

# ─── Cesium Ion (for satellite imagery)
# Free at: https://ion.cesium.com/ (1GB/month free)
CESIUM_ION_TOKEN=your_cesium_ion_token_here

# ─── Google Gemini AI (free: 1500 req/day)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── NewsAPI (free: 100 req/day)
# Free account: https://newsapi.org/register
NEWSAPI_KEY=

# ─── AISStream.io (free WebSocket AIS data - optional upgrade for ships)
# Free account: https://aisstream.io
# Without this key, ship tracking falls back to Norwegian + Finnish free AIS
# feeds (~10-15 real vessels, Nordic waters only) plus a STATIC catalog baseline
# for the rest (~130 known warships, last-known homeport position, flagged
# isBaseline:true in the UI). Set this key for real global live tracking.
AISSTREAM_KEY=

# ─── ACLED (free, most precise conflict event dataset — optional upgrade for conflicts)
# Free account: https://acleddata.com/register/
# Without these, conflictService.js silently skips ACLED and relies on GDELT/ReliefWeb/FIRMS only.
ACLED_API_KEY=
ACLED_EMAIL=

# ─── NASA FIRMS (free thermal anomaly / explosion detection)
# Register at: https://firms.modaps.eosdis.nasa.gov/api/area/
# Then copy your MAP_KEY here. Without this key FIRMS data is silently skipped.
FIRMS_MAP_KEY=

# ─── Stripe (payments / subscriptions)
# Create account at https://stripe.com → Developers → API keys
# Use test keys (sk_test_...) during development, live keys (sk_live_...) in production
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
# Webhook signing secret — from Stripe Dashboard → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Price IDs — from Stripe Dashboard → Products → (your product) → Prices
STRIPE_PRICE_MONTHLY=price_monthly_id_here
STRIPE_PRICE_ANNUAL=price_annual_id_here
# Frontend URL for Stripe redirect (override in production)
FRONTEND_URL=http://localhost:5173

# ─── Supabase (required for auth + historical data)
# Create project at https://supabase.com → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key
# Service role key — bypasses RLS, needed for Stripe webhook profile writes
# Supabase Dashboard → Settings → API → service_role key (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
