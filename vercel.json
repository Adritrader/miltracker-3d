{
  "buildCommand": "cd frontend && NODE_OPTIONS=--max-old-space-size=6144 npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm ci",
  "framework": null,
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Permissions-Policy": "unload=(), bluetooth=(), usb=(), serial=(), hid=(), midi=()",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
